# /etc/nginx/sites-available/voice-assistant, then: certbot --nginx -d voice-assistant.nathan-petitboulanger.fr
# Only the page and one POST per call go through here: the audio goes from the phone
# to OpenAI directly (WebRTC).
server {
    listen 80;
    server_name voice-assistant.nathan-petitboulanger.fr;

    location / {
        proxy_pass http://127.0.0.1:8098;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
